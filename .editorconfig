# https://editorconfig.org
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{py,java,cs,ps1}]
indent_size = 4

[*.{js,mjs,cjs,css,html,json,webmanifest,md,yml,yaml,toml,xml,gradle}]
indent_size = 2

[*.{sh,service}]
end_of_line = lf

[*.md]
trim_trailing_whitespace = false
