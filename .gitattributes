# Keep source and documentation stable across Windows/POSIX checkouts.
* text=auto
*.sh text eol=lf
*.service text eol=lf
*.go text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.sqlite3 binary
*.pyc binary

# Tutorial assets are generated byte-for-byte by scripts/dev/build_demo_assets.py.
ark_studio/demo/tutorial/** -text
*.pdf binary
*.mp4 binary
*.ico binary
*.icns binary
*.nsh text eol=crlf
*.zip binary
