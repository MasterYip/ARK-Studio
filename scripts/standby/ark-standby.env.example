# ~/.config/ark-standby/ark-standby.env, the same file on the primary and the standby.
# Paths are identical on both machines (the organization database stores
# absolute project paths).

# Data replicated from the primary
ARK_PROJECTS=/srv/ark/projects
ARK_PRIVATE=/srv/ark/private
ARK_EXTRA_DIRS=""                         # more folders replicated as files
ARK_EXTRA_DBS="/srv/ark/ARK-Studio/runtime/org.sqlite3"   # databases outside those folders
ARK_CONFIG=/home/ark/.config/arkstudio/main.json
SYNC_EXCLUDES=".cache/ __pycache__/ .tmp-* *.tmp deployment-backups/ logs/"
SYNC_BWLIMIT=""                           # KiB/s, empty = unlimited
SNAP_DIR=/var/tmp/ark-standby-snap        # primary: the sync's own snapshot folder, off the data disk
PRIMARY_NAME=primary

# The standby as seen from the primary
STANDBY_SSH=ark@10.0.0.2
STANDBY_SSH_PORT=22
STANDBY_SSH_KEY=/home/ark/.ssh/ark_standby_ed25519
STANDBY_BASE=/srv/ark/standby
STANDBY_TOOLS=/home/ark/.local/share/ark-standby
STANDBY_UNIT=ark-server@bkp.service
STANDBY_CONFIG=~/.config/arkstudio/bkp.json
STANDBY_PORT=8891
STANDBY_PUBLIC_URL=https://ark-bkp.example.org:8443
STANDBY_PUBLIC_IP=203.0.113.2
DAILY_KEEP=7

# The primary as seen from the standby (failover)
PRIMARY_SSH=ark@10.0.0.1
PRIMARY_SSH_PORT=22
PRIMARY_SSH_KEY=/home/ark/.ssh/ark_primary_ed25519
PRIMARY_UNIT=ark-server@main.service
PRIMARY_PORT=8890
PRIMARY_DIRECT_HOST=ark.example.org
PRIMARY_DIRECT_PORT=8443
PRIMARY_PUBLIC_IP=203.0.113.1
PRIMARY_TOOLS=/home/ark/.local/share/ark-standby
PRIMARY_SNAP_DIR=/var/tmp/ark-standby-snap
PRIMARY_BACKUPS=/home/ark/ark-backups
