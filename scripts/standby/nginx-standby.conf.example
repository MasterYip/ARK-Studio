# /etc/nginx/sites-available/ark-standby.conf: the standby behind HTTPS.
# Same shape as the primary's site; both names so DNS can move to this host.
limit_req_zone $binary_remote_addr zone=ark_standby:10m rate=20r/s;

server {
    listen 8443 ssl http2;
    listen [::]:8443 ssl http2;
    server_name ark-bkp.example.org ark.example.org;

    ssl_certificate     /etc/nginx/ssl/ark-standby/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/ark-standby/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 25m;

    location / {
        limit_req zone=ark_standby burst=80 nodelay;
        proxy_pass http://127.0.0.1:8891;
        proxy_http_version 1.1;
        proxy_set_header Host $host:$server_port;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}
