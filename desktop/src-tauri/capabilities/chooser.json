{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "chooser",
  "description": "Bundled pages (connection chooser, settings, offline page) in both windows. ARK server pages get a runtime capability with only the window controls and the local-open bridge (src/lib.rs, grant_server_origin).",
  "local": true,
  "windows": ["chooser", "main"],
  "permissions": [
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "allow-close-window",
    "allow-open-chooser",
    "allow-get-state",
    "allow-pick-folder",
    "allow-connect-local",
    "allow-connect-remote",
    "allow-save-settings",
    "allow-forget-remote",
    "allow-open-data-dir",
    "allow-open-log",
    "allow-stop-local",
    "allow-check-update"
  ]
}
