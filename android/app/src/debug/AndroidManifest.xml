<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets adb feed a pairing URL through the QR path
     (adb: am start with action DEBUG_PAIR and a string extra named url). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="com.masteryip.arkstudio.DEBUG_PAIR" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
