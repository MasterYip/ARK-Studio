{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARK Studio",
  "mainBinaryName": "ark-studio",
  "version": "2.1.2",
  "identifier": "io.github.masteryip.arkstudio",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "node scripts/prepare-ui.mjs",
    "beforeDevCommand": "node scripts/prepare-ui.mjs"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http: https:",
      "capabilities": ["bundled"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage", "app", "dmg"],
    "externalBin": ["binaries/ark-server"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "ARK Studio: a local-first research workspace",
    "longDescription": "ARK (Auto-Research Kit) is a local-first, node-first research workbench for ideas, plans, maps, agent tasks, production and distribution. The desktop app runs a private local ARK server or connects to a remote one.",
    "publisher": "Raymon Yip",
    "copyright": "Copyright (c) Raymon Yip. AGPL-3.0 License.",
    "license": "AGPL-3.0-only",
    "licenseFile": "../../../LICENSE",
    "homepage": "https://github.com/MasterYip/ARK-Studio",
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": ["en-US"]
      }
    },
    "linux": {
      "deb": {
        "section": "utils"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGOUQ4RDg1MDUxOTUyMTYKUldRV1Voa0ZoWTJkMzBlQUpPUHgwWTg4aFl0bVRHZ0pXdWptNWZncGh3RTlTUytMbWlubUtpK3MK",
      "endpoints": [
        "https://github.com/MasterYip/ARK-Studio/releases/latest/download/latest.json",
        "https://github.com/MasterYip/ARK-Studio/releases/download/updater/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
