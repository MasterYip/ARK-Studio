{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "bundled",
  "description": "Bundled pages (Settings, the status page, the Windows tray window). ARK server pages get runtime capabilities instead (src/lib.rs, grant_server_origin): every server page the window controls, the local-open bridge, desktop_context, go_local_home and link_server (remote pages only); the local ARK page also the desktop hub.",
  "local": true,
  "windows": ["settings", "main", "tray-menu"],
  "permissions": [
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "allow-close-window",
    "allow-get-state",
    "allow-pick-folder",
    "allow-connect-local",
    "allow-connect-remote",
    "allow-save-settings",
    "allow-forget-remote",
    "allow-open-data-dir",
    "allow-open-log",
    "allow-stop-local",
    "allow-check-update",
    "allow-open-releases",
    "allow-desktop-context",
    "allow-go-local-home",
    "allow-desktop-servers",
    "allow-server-status",
    "allow-open-server",
    "allow-open-settings",
    "allow-server-projects",
    "allow-unlink-server",
    "allow-open-local-settings",
    "allow-tray-menu-ready",
    "allow-tray-menu-action",
    "allow-show-download",
    "allow-restart-app"
  ]
}
